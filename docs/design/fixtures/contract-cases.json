{
  "schema": "omasafe.design-contract-cases.v1",
  "cases": [
    {
      "id": "edge-confidence-is-local",
      "input": {
        "lexicalOnlyCount": 1,
        "edges": [
          { "key": "lexical", "support": { "parserBacked": 0, "lexicalOnly": 3 } },
          { "key": "mixed", "support": { "parserBacked": 2, "lexicalOnly": 1 } },
          { "key": "parsed", "support": { "parserBacked": 4, "lexicalOnly": 0 } }
        ]
      },
      "expect": {
        "notice": "1 analyzed plugin used lexical-only analysis; affected edges are dashed.",
        "dashed": ["lexical"],
        "solid": ["mixed", "parsed"],
        "mixed_inspector": "mixed evidence: 2 parser-backed · 1 text-match-only"
      }
    },
    {
      "id": "multiple-independent-blocks-retain-urgent",
      "input": { "decisions": ["block", "block", "allow"] },
      "expect": { "urgent_block_rows": 2, "hidden_rows": 0 }
    },
    {
      "id": "same-membership-content-revision",
      "input": {
        "membershipKey_before": "8|5|6|12|all|nobackups",
        "membershipKey_after": "8|5|6|12|all|nobackups",
        "contentKey_before": "analysis-rev:3|alerts-rev:9|trust-rev:12",
        "contentKey_after": "analysis-rev:4|alerts-rev:9|trust-rev:12"
      },
      "expect": { "assign_nodes": true, "preserve_existing_order": true, "append_new_nodes": true }
    },
    {
      "id": "stale-enable-authorization",
      "input": { "action": "enable", "expected_digest": "aaaa", "actual_digest_under_lock": "bbbb" },
      "expect": { "exit": "refused", "writes": 0 }
    },
    {
      "id": "stale-remove-authorization",
      "input": { "action": "remove", "expected_trusted_digest": "aaaa", "actual_trusted_digest_under_lock": "bbbb" },
      "expect": { "exit": "refused", "writes": 0 }
    },
    {
      "id": "known-limitations",
      "input": [
        "time_budget_exhausted",
        "suppressions-unreadable:permission denied: policy.json",
        "suppression-reconfirmation-required:2",
        "equivalence-map-stale:map-v3-observed-v4"
      ],
      "expect": { "unsupported_count": 0, "preserve_value_after_first_colon": true }
    },
    {
      "id": "hostile-and-unknown-copy",
      "input": { "plugin_id": "<b>x</b>", "classification": "vendored", "severity": "extreme" },
      "expect": { "text_format": "PlainText", "classification_label": "unsupported", "severity_label": "unsupported", "urgent": false }
    }
  ]
}
